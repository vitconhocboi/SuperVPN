<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ratingBar">
        <item name="colorControlNormal">#B1B1B1</item>
        <item name="colorControlActivated">#FFC107</item>
    </style>

    <style name="SlTextBase" />

    <style name="TextBase.Regular" parent="@style/SlTextBase">
        <item name="android:fontFamily">@font/sf_pro_regular</item>
    </style>

    <style name="Body12Regular" parent="@style/TextBase.Regular">
        <item name="android:textSize">@dimen/_13ssp</item>
    </style>

    <style name="Caption12Regular" parent="@style/TextBase.Regular">
        <item name="android:textSize">@dimen/_13ssp</item>
    </style>

    <style name="Caption14Regular" parent="@style/TextBase.Regular">
        <item name="android:textSize">@dimen/_14ssp</item>
    </style>

    <style name="Caption14Bold" parent="@style/TextBase.Bold">
        <item name="android:textSize">@dimen/_15ssp</item>
    </style>

    <style name="TextBase.Bold" parent="@style/SlTextBase">
        <item name="android:fontFamily">@font/sf_pro_bold</item>
    </style>

    <style name="Body14Bold" parent="@style/TextBase.Bold">
        <item name="android:textSize">@dimen/_15ssp</item>
    </style>

    <style name="Title1Line14Bold" parent="@style/TextBase.Bold">
        <item name="android:textSize">@dimen/_15ssp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Caption10Regular" parent="@style/TextBase.Regular">
        <item name="android:textSize">@dimen/_11ssp</item>
    </style>

    <style name="CtaStyle"  parent="@style/TextBase.Bold">
        <item name="android:textAllCaps">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_14sdp</item>
    </style>
</resources>