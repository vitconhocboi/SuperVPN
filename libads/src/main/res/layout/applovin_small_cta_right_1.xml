<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_6sdp"
    android:background="@drawable/lib_bg_native_ad">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/background"
        android:paddingVertical="@dimen/_5sdp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_60sdp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/ad_notification_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:background="@drawable/lib_gnt_rounded_corners_shape"
            android:gravity="center"
            android:minWidth="@dimen/_12sdp"
            android:minHeight="@dimen/_12sdp"
            android:paddingStart="@dimen/_2sdp"
            android:paddingTop="@dimen/_1sdp"
            android:paddingEnd="@dimen/_2sdp"
            android:paddingBottom="@dimen/_1sdp"
            android:text="Ad"
            android:textColor="@color/white"
            android:textSize="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="@+id/primary"
            app:layout_constraintStart_toEndOf="@id/icon"
            app:layout_constraintTop_toTopOf="@id/icon" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginStart="@dimen/_12sdp"
            tools:background="@color/gray_shimmer"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="@id/body"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/primary"
            style="@style/Title1Line14Bold"
            android:layout_width="0.0dip"
            tools:text="Titleaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:textColor="@color/lib_ads_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cta"
            app:layout_constraintStart_toEndOf="@id/ad_notification_view"
            app:layout_constraintTop_toTopOf="@id/icon"
            app:layout_goneMarginStart="@dimen/_12sdp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/body"
            style="@style/Caption10Regular"
            android:layout_width="0.0dip"
            tools:text="Bodyaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_6sdp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/lib_ads_body"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cta"
            app:layout_constraintStart_toStartOf="@id/ad_notification_view"
            app:layout_constraintTop_toBottomOf="@id/primary" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_12sdp"
            android:background="@drawable/lib_bg_radius_10"
            android:backgroundTint="@color/lib_bg_cta"
            android:ellipsize="end"
            android:fontFamily="@font/sf_pro_bold"
            android:gravity="center"
            android:maxWidth="@dimen/_100sdp"
            android:maxLines="2"
            android:paddingStart="@dimen/_12sdp"
            android:paddingTop="@dimen/_6sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:paddingBottom="@dimen/_6sdp"
            style="@style/CtaStyle"
            app:layout_constraintBottom_toBottomOf="@id/body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/primary" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
