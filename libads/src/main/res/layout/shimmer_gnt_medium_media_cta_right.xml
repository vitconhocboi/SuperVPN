<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_130sdp"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/media_view"
            android:layout_width="0dp"
            android:layout_height="@dimen/_120sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@color/gray_shimmer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.35" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/ad_notification_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/lib_gnt_rounded_corners_shape"
            android:gravity="center"
            android:minWidth="@dimen/_12sdp"
            android:minHeight="@dimen/_12sdp"
            android:paddingStart="@dimen/_2sdp"
            android:paddingTop="@dimen/_1sdp"
            android:paddingEnd="@dimen/_2sdp"
            android:paddingBottom="@dimen/_1sdp"
            android:text="Ad"
            android:textColor="@color/white"
            android:textSize="@dimen/_8sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/primary"
            style="@style/Caption14Regular"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:background="@color/gray_shimmer"
            android:ellipsize="end"
            android:lines="1"
            android:textColor="@color/gnt_text_color"
            app:layout_constraintBottom_toTopOf="@+id/body"
            app:layout_constraintEnd_toStartOf="@id/cta"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@id/media_view"
            app:layout_constraintTop_toTopOf="@+id/media_view"
            app:layout_goneMarginStart="@dimen/_12sdp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/body"
            style="@style/Body12Regular"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/_55sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginTop="@dimen/size10"
            android:layout_marginEnd="@dimen/_6sdp"
            android:background="@color/gray_shimmer"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/gnt_text_color"
            app:layout_constraintBottom_toBottomOf="@+id/media_view"
            app:layout_constraintEnd_toStartOf="@id/cta"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@id/media_view"
            app:layout_constraintTop_toBottomOf="@+id/primary"
            app:layout_goneMarginStart="@dimen/_12sdp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/cta"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_12sdp"
            android:ellipsize="end"
            android:fontFamily="@font/sf_pro_bold"
            android:gravity="center"
            android:maxWidth="@dimen/_100sdp"
            android:maxLines="2"
            android:paddingStart="@dimen/_12sdp"
            android:background="@color/gray_shimmer"
            android:paddingTop="@dimen/_6sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:paddingBottom="@dimen/_6sdp"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="@+id/media_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/media_view" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
