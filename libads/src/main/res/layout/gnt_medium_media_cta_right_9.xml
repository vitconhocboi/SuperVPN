<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_130sdp"
    android:background="@drawable/lib_bg_native_ad">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/media_view"
            android:layout_width="0dp"
            android:layout_height="@dimen/_120sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@drawable/lib_mediaview"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.35" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/primary"
            style="@style/Title1Line14Bold"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:text="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            android:textColor="@color/lib_ads_primary"
            app:layout_constraintEnd_toStartOf="@id/cta"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@id/media_view"
            app:layout_constraintTop_toTopOf="@+id/media_view"
            app:layout_goneMarginStart="@dimen/_12sdp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/ad_notification_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:background="@drawable/lib_gnt_rounded_corners_shape"
            android:gravity="center"
            android:minWidth="@dimen/_15sdp"
            android:minHeight="@dimen/_15sdp"
            android:paddingStart="@dimen/_2sdp"
            android:layout_marginTop="@dimen/size5"
            android:paddingTop="@dimen/_1sdp"
            android:paddingEnd="@dimen/_2sdp"
            android:paddingBottom="@dimen/_1sdp"
            android:text="Ad"
            android:textColor="@color/white"
            android:textSize="@dimen/_8sdp"
            app:layout_constraintStart_toEndOf="@id/media_view"
            app:layout_constraintTop_toBottomOf="@id/primary" />

        <androidx.appcompat.widget.AppCompatRatingBar
            android:id="@+id/rating_bar"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:lines="1"
            android:numStars="5"
            android:stepSize="0.1"
            android:layout_marginStart="@dimen/size5"
            android:textColor="@color/lib_ads_primary"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="@+id/ad_notification_view"
            app:layout_constraintStart_toEndOf="@id/ad_notification_view"
            app:layout_constraintTop_toTopOf="@+id/ad_notification_view"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/body"
            style="@style/Body12Regular"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginTop="@dimen/size10"
            android:layout_marginEnd="@dimen/_6sdp"
            android:layout_marginBottom="@dimen/_18sdp"
            android:ellipsize="end"
            android:maxLines="4"
            android:textColor="@color/lib_ads_body"
            app:layout_constraintEnd_toStartOf="@id/cta"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@id/media_view"
            app:layout_constraintTop_toBottomOf="@+id/ad_notification_view"
            app:layout_goneMarginStart="@dimen/_12sdp"
            tools:text="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/cta"
            style="@style/CtaStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_12sdp"
            android:background="@drawable/lib_bg_radius_10"
            android:backgroundTint="@color/lib_bg_cta"
            android:ellipsize="end"
            android:maxWidth="@dimen/_100sdp"
            android:maxLines="2"
            android:paddingStart="@dimen/_12sdp"
            android:paddingTop="@dimen/_6sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:paddingBottom="@dimen/_6sdp"
            app:layout_constraintBottom_toBottomOf="@+id/media_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/media_view" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
