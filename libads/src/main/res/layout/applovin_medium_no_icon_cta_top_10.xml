<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/native_ad_view"
    android:layout_marginBottom="@dimen/_10sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/lib_bg_native_ad">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/_12sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingEnd="@dimen/_12sdp"
        android:paddingBottom="@dimen/_12sdp">

        <FrameLayout
            android:id="@+id/media_view"
            android:layout_width="0dp"
            android:gravity="center"
            android:background="@drawable/lib_mediaview"
            app:layout_constraintWidth_percent="0.5"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_height="@dimen/_120sdp"
            app:layout_constraintTop_toBottomOf="@id/cta" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/primary"
            style="@style/Title1Line14Bold"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            tools:text="Title"
            android:textColor="@color/lib_ads_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/media_view"
            app:layout_constraintTop_toTopOf="@id/media_view"
            app:layout_goneMarginStart="0.0dip" />



        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/body"
            style="@style/Caption12Regular"
            android:layout_width="0.0dip"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="3"
            tools:text="Body yyyyyyyyyyyyyyyyyy
            yyyyyyyyyyyyyy
            yyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
            android:textColor="@color/lib_ads_body"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="@+id/media_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/primary"
            app:layout_constraintTop_toBottomOf="@id/primary" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/lib_bg_radius_10"
            android:backgroundTint="@color/lib_bg_cta"
            android:fontFamily="@font/sf_pro_bold"
            android:padding="@dimen/_9sdp"
            style="@style/CtaStyle"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/ad_notification_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_6sdp"
        android:background="@drawable/lib_gnt_rounded_corners_shape"
        android:gravity="center"
        android:minWidth="@dimen/_15sdp"
        android:minHeight="@dimen/_15sdp"
        android:paddingStart="@dimen/_2sdp"
        android:layout_marginTop="@dimen/size5"
        android:paddingTop="@dimen/_1sdp"
        android:paddingEnd="@dimen/_2sdp"
        android:paddingBottom="@dimen/_1sdp"
        android:text="Ad"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="@dimen/_3sdp"
        android:layout_marginBottom="@dimen/_3sdp"
        android:textColor="@color/white"
        android:textSize="@dimen/_8sdp"
        />
</FrameLayout>
