<?xml version="1.0" encoding="UTF-8"?>

<!--is_hide_navigation_bar = tắt navigationBar-->
<!--is_always_show_intro_and_language_screen = Luôn hiển thị màn hình language và intro - onboarding khi vào app-->
<!--is_enable_introduction_screen = Cho phép hiển thị màn hình intro - onboarding-->
<!--is_enable_change_language_screen = Cho phép hiển thị màn hình language-->
<!--is_enable_app_shortcut = Mở short cut-->
<!--is_enable_app_shortcut_uninstall = Mở short cut uninstall-->

<!--intro data (số phần tử = số trang onboarding; giá trị 2 = trang bị lọc bỏ)-->
<defaults>
    <entry>
        <key>application_config</key>
        <value>
            {
            "is_hide_navigation_bar": true,
            "is_always_show_intro_and_language_screen": true,
            "is_always_show_intro_and_language_screen_with_interval": true,
            "is_enable_introduction_screen": true,
            "is_enable_change_language_screen": true,
            "is_enable_app_shortcut": true,
            "is_enable_app_shortcut_uninstall": true,
            "interval_day_always_show_intro_and_language": 1,
            "intro_data": [
            0,
            2,
            0,
            2,
            1
            ],
            "intro_data_v2": [
            0,
            2,
            0,
            2,
            1
            ]
            }
        </value>
    </entry>
    <entry>
        <key>onboarding_config</key>
        <value>
            {
            "version": 2
            }
        </value>
    </entry>
</defaults>
