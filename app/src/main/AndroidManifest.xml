<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.tici.vpn.proxy.master">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.ACTIVATE_VPN" />
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE"
        tools:ignore="ProtectedPermissions" />
<!--    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />-->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />


    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name="com.tici.vpn.proxy.master.SuperVpnApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:windowSoftInputMode="adjustResize"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SuperVPN.Splash"
        tools:targetApi="33">

        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />

        <activity
            android:name="com.tici.vpn.proxy.master.proxy.ProxyActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SuperVPN" />

        <activity
            android:name="com.tici.vpn.proxy.master.ipinfo.IpInfoActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SuperVPN" />

        <activity
            android:name="com.tici.vpn.proxy.master.language.LanguageActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SuperVPN" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/app_ads_id" />

        <activity
            android:name="com.tici.vpn.proxy.master.splash.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SuperVPN.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="com.tici.vpn.proxy.master.network.LocalVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.service.vpn.VpnService" />
            </intent-filter>
        </service>

        <activity
            android:name="com.tici.vpn.proxy.master.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SuperVPN" />
        <activity
            android:name="com.tici.vpn.proxy.master.premium.PremiumActivity"
            android:exported="true"
            android:theme="@style/Theme.SuperVPN" />

<!--        <receiver-->
<!--            android:name="com.tici.vpn.proxy.master.broadcast.SchedulerReceiver"-->
<!--            android:enabled="true"-->
<!--            android:exported="true">-->
<!--            <intent-filter>-->
<!--                <action android:name="super-vpn.STOP_PROXY" />-->
<!--            </intent-filter>-->
<!--            <intent-filter>-->
<!--                <action android:name="android.intent.action.BOOT_COMPLETED" />-->
<!--            </intent-filter>-->
<!--        </receiver>-->
    </application>

</manifest>