<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/backgroundColor2"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size56"
        android:background="@color/topBarColor"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:gravity="start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:fontFamily="@font/pixeloid_sans_bold"
            android:textFontWeight="1000"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="@string/setting_language"
            android:textAllCaps="false"
            android:textColor="#3C3C3C"
            android:textSize="@dimen/text_huge"
            tools:ignore="SpUsage" />

        <FrameLayout
            android:layout_width="@dimen/size56"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/size5"
            android:layout_height="@dimen/size56">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressLoadAds"
                android:indeterminateTint="@color/primary_color"
                android:layout_width="match_parent"
                android:padding="@dimen/size12"
                android:layout_gravity="center"
                android:layout_height="match_parent"/>
        </FrameLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <View
        android:layout_width="match_parent"
        android:background="#D6D6D6"
        android:visibility="invisible"
        android:layout_height="@dimen/size1"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/rcvLanguage"
        android:layout_marginTop="1dp"
        app:spanCount="1"
        android:paddingHorizontal="@dimen/size10"
        android:clipToPadding="false"
        android:orientation="vertical"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        tools:listitem="@layout/item_language"
        android:layout_weight="1"/>

    <com.simple.libads.FrameAds
        android:layout_width="match_parent"
        android:id="@+id/frameAds"
        android:layout_height="wrap_content"/>

</androidx.appcompat.widget.LinearLayoutCompat>