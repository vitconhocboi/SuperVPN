<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash"
    android:fitsSystemWindows="true"
    tools:context=".splash.SplashActivity">

    <ProgressBar
        android:id="@+id/customProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_marginHorizontal="@dimen/size30"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size8"
        android:layout_marginBottom="@dimen/size14"
        android:indeterminate="false"
        android:indeterminateTint="@color/primary_color"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/progress_bar"
        android:background="@drawable/progress_bar"
        android:clipToOutline="true"
        app:layout_constraintBottom_toTopOf="@+id/ads_notice" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/ads_notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size10"
        android:text="@string/ads_message_notice"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>