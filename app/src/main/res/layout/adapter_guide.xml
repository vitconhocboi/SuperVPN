<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#11141D"
    android:orientation="vertical">

    <!--    <androidx.cardview.widget.CardView-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        android:layout_marginHorizontal="@dimen/size24"-->
    <!--        android:layout_marginTop="@dimen/size58"-->
    <!--        app:cardCornerRadius="16dp"-->
    <!--        app:cardElevation="0dp">-->

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivGuideImage"
        android:layout_width="wrap_content"
        android:layout_gravity="center"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size2"
        android:layout_marginTop="@dimen/size58"
        android:adjustViewBounds="true"
        android:background="#11141D"
        android:scaleType="centerCrop"
        android:src="@drawable/guide2" />
    <!--    </androidx.cardview.widget.CardView>-->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size20"
            android:layout_marginBottom="@dimen/size30"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:singleLine="false"
            android:inputType="textMultiLine"
            android:ellipsize="none"
            android:lines="2"
            android:paddingHorizontal="@dimen/size20"
            android:text="@string/guide_2"
            android:textColor="@color/white"
            android:textSize="@dimen/text_large" />
    </FrameLayout>
</androidx.appcompat.widget.LinearLayoutCompat>