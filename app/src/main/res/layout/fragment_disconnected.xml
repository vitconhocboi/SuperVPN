<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".home.ConnectedFragment">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/bgLlInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivFlag"
            android:layout_width="@dimen/size64"
            android:layout_height="@dimen/size64"
            android:layout_marginTop="@dimen/_10dp"
            android:scaleType="centerCrop"
            android:src="@drawable/flag_us"
            app:shapeAppearanceOverlay="@style/CircleImageView" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/titleCountry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size16"
            android:fontFamily="@font/inter_bold"
            android:text="United States"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/size14" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/pn_ip_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_8dp"
            android:layout_marginTop="@dimen/size12"
            android:background="@drawable/bg_ip_info"
            android:gravity="top"
            android:orientation="vertical"
            android:padding="@dimen/size12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_normal"
                    android:text="@string/duration"
                    android:textColor="#70788F"
                    android:textSize="@dimen/size14" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDuration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_normal"
                    android:text="00:15:23"
                    android:textAlignment="viewEnd"
                    android:textColor="#ECEFF5"
                    android:textSize="@dimen/size14" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size12">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_normal"
                    android:text="@string/upload"
                    android:textColor="#70788F"
                    android:textSize="@dimen/size14" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvUpload"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_normal"
                    android:text="32m/s"
                    android:textAlignment="viewEnd"
                    android:textColor="#ECEFF5"
                    android:textSize="@dimen/size14" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size12">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_normal"
                    android:text="@string/download"
                    android:textColor="#70788F"
                    android:textSize="@dimen/size14" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDownload"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_normal"
                    android:text="32m/s"
                    android:textAlignment="viewEnd"
                    android:textColor="#ECEFF5"
                    android:textSize="@dimen/size14" />
            </LinearLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <RelativeLayout
        android:id="@+id/layout_ads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_8dp"
        android:layout_marginTop="@dimen/_12dp"
        app:layout_constraintTop_toBottomOf="@+id/bgLlInfo">

        <com.core.ads.customviews.ads.BannerNativeContainerLayout
            android:id="@+id/layout_banner_native"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true" />
    </RelativeLayout>


    <TextView
        android:id="@+id/tvDoneExit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_22dp"
        android:layout_marginTop="@dimen/_20dp"
        android:layout_marginBottom="@dimen/_5dp"
        android:background="@drawable/bg_border_uninstall"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center"
        android:paddingVertical="@dimen/_14dp"
        android:text="@string/tv_done"
        android:textColor="@color/blue_language_select"
        android:textSize="@dimen/_15sp"
        app:layout_constraintBottom_toBottomOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>