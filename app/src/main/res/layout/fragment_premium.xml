<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/frame_corner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pre_corner"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ic_pre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_premium"
            android:scaleType="centerInside"
            android:visibility="invisible"
            />

    </FrameLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bgImg"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:src="@drawable/bg_earth"
        android:foreground="?selectableItemBackgroundBorderless"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_close"
        android:layout_width="@dimen/size32"
        android:layout_height="@dimen/size32"
        android:layout_marginTop="@dimen/margin_16"
        android:layout_marginEnd="@dimen/margin_16"
        android:src="@drawable/ic_close"
        android:foreground="?selectableItemBackgroundBorderless"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_68"
        android:layout_marginHorizontal="@dimen/margin_big"
        android:ellipsize="middle"
        android:gravity="center"
        android:text="@string/premium_title"
        android:textSize="@dimen/text_super_huge"
        android:textAppearance="@style/App_TextAppearanceTitle1"
        android:textColor="@color/successColor"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_sub1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_16"
        android:ellipsize="middle"
        android:text="@string/premium_sub1"
        android:textColor="@color/text_gray_1"
        android:textSize="@dimen/text_normal"
        android:drawableStart="@drawable/ic_pre"
        android:drawablePadding="@dimen/size10"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:layout_constraintStart_toStartOf="@+id/tv_sub2"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_sub2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_16"
        android:ellipsize="middle"
        android:text="@string/premium_sub2"
        android:textColor="@color/text_gray_1"
        android:textSize="@dimen/text_normal"
        android:drawableStart="@drawable/ic_pre"
        android:drawablePadding="@dimen/size10"
        app:layout_constraintTop_toBottomOf="@+id/tv_sub1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_sub3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_16"
        android:ellipsize="middle"
        android:text="@string/premium_sub3"
        android:textColor="@color/text_gray_1"
        android:textSize="@dimen/text_normal"
        android:drawableStart="@drawable/ic_pre"
        android:drawablePadding="@dimen/size10"
        app:layout_constraintTop_toBottomOf="@+id/tv_sub2"
        app:layout_constraintStart_toStartOf="@+id/tv_sub2"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_sub4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_16"
        android:ellipsize="middle"
        android:text="@string/premium_sub4"
        android:textColor="@color/text_gray_1"
        android:textSize="@dimen/text_normal"
        android:drawableStart="@drawable/ic_pre"
        android:drawablePadding="@dimen/size10"
        app:layout_constraintTop_toBottomOf="@+id/tv_sub3"
        app:layout_constraintStart_toStartOf="@+id/tv_sub2"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvSkus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintTop_toBottomOf="@+id/tv_sub4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/adapter_sku_item" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_32"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:layout_marginHorizontal="@dimen/margin_big"
        android:text="@string/premium_desc"
        android:textColor="@color/text_gray_2"
        android:textSize="@dimen/text_normal"
        app:layout_constraintTop_toBottomOf="@+id/rcvSkus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <LinearLayout
        android:id="@+id/start_trial"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingHorizontal="@dimen/margin_16"
        android:layout_marginTop="@dimen/margin_12"
        android:layout_marginHorizontal="@dimen/margin_16"
        android:gravity="center"
        android:background="@drawable/bg_start_trial"
        android:foreground="?selectableItemBackgroundBorderless"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/btn_start_trial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:textAppearance="@style/App_TextAppearanceTitle2"
            android:textAllCaps="true"
            android:text="@string/premium_start_trial"
            android:textColor="@color/text_gray_1"/>
    </LinearLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvMsg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_32"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_marginHorizontal="@dimen/margin_big"
        android:text="@string/premium_trial_desc"
        android:maxLines="2"
        android:textColor="@color/text_gray_2"
        android:textSize="@dimen/text_normal"
        app:layout_constraintTop_toBottomOf="@+id/start_trial"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:indeterminateTint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="invisible"
        />


</androidx.constraintlayout.widget.ConstraintLayout>