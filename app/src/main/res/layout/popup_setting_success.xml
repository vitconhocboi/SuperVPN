<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size100"
    android:layout_marginTop="@dimen/margin_big"
    android:layout_marginHorizontal="@dimen/margin_medium"
    android:background="@drawable/bg_feedback_complete"
    android:gravity="center">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size16"
        android:layout_marginHorizontal="@dimen/margin_20"
        android:fontFamily="@font/roboto_regular"
        android:text="@string/setting_app_proxy_success"
        android:gravity="start"
        android:maxLines="1"
        android:ellipsize="end"
        android:textStyle="bold"
        android:textAlignment="viewStart"
        android:textColor="@color/successColor"
        android:textSize="@dimen/text_medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvClose"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size16"
        android:layout_marginHorizontal="@dimen/margin_20"
        android:layout_marginBottom="@dimen/size20"
        android:fontFamily="@font/roboto_regular"
        android:gravity="start"
        android:text="@string/reconnect_to_take_effect"
        android:textColor="#000000"
        android:textSize="@dimen/text_normal"
        app:layout_constraintStart_toStartOf="@+id/tvTitle"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toBottomOf="parent"/>


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_regular"
        android:layout_marginEnd="@dimen/margin_20"
        android:gravity="end"
        android:text="@string/got_it"
        android:textColor="#E92B2B"
        android:textStyle="bold"
        android:textSize="@dimen/text_medium"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitle" />
</androidx.constraintlayout.widget.ConstraintLayout>