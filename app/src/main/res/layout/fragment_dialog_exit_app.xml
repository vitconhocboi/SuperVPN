<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/bg_border_dialog_exit"
    android:minHeight="@dimen/_162dp">

    <TextView
        android:id="@+id/tvTitleExitApp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16dp"
        android:layout_marginBottom="@dimen/_10dp"
        android:fontFamily="@font/roboto_medium"
        android:paddingTop="@dimen/_16dp"
        android:text="@string/tv_exit_application"
        android:textAlignment="viewStart"
        android:textColor="@color/black"
        android:textSize="@dimen/_16sp"
        app:layout_constraintBottom_toTopOf="@+id/tvContentExitApp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvContentExitApp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16dp"
        android:layout_marginBottom="@dimen/_20dp"
        android:fontFamily="@font/roboto"
        android:text="@string/tv_want_to_exit_application"
        android:textAlignment="viewStart"
        android:textColor="@color/black"
        app:layout_constraintBottom_toTopOf="@+id/tvNoExit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvNoExit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16dp"
        android:layout_marginBottom="@dimen/_20dp"
        android:background="@drawable/bg_border_button_reject"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center"
        android:paddingVertical="@dimen/_15dp"
        android:text="@string/tv_no"
        android:textColor="@color/black"
        android:textSize="@dimen/_15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvExitApp"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvExitApp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_16dp"
        android:layout_marginBottom="@dimen/_20dp"
        android:background="@drawable/bg_border_uninstall"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center"
        android:paddingVertical="@dimen/_15dp"
        android:text="@string/tv_exit_new"
        android:textColor="@color/blue_language_select"
        android:textSize="@dimen/_15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvNoExit" />
    

</androidx.constraintlayout.widget.ConstraintLayout>
