<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/size8"
    android:layout_marginVertical="@dimen/size4"
    android:background="@drawable/bg_radius_8"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size12">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitle"
            android:layout_width="@dimen/size200"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size12"
            android:layout_marginTop="@dimen/size12"
            android:fontFamily="@font/inter_bold"
            android:gravity="center_vertical"
            android:text="@string/us"
            android:textColor="@color/textColor"
            android:textSize="@dimen/text_large"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvProxyIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size12"
            android:layout_marginBottom="@dimen/size12"
            android:fontFamily="@font/inter_bold"
            android:gravity="center_vertical"
            android:text="103.23.23.123"
            android:textColor="@color/gray_2"
            android:textSize="@dimen/text_normal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvNetworkSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_24"
            android:fontFamily="@font/inter_bold"
            android:gravity="center_vertical"
            android:drawableStart="@drawable/ic_wifi"
            android:drawablePadding="@dimen/margin_medium"
            android:text="16m/s"
            android:textColor="@color/green_1"
            android:textSize="@dimen/text_normal"
            app:layout_constraintBottom_toBottomOf="@id/tvProxyIp"
            app:layout_constraintStart_toEndOf="@+id/tvProxyIp"
            app:layout_constraintTop_toTopOf="@id/tvProxyIp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivNext"
            android:layout_width="0dp"
            android:layout_height="@dimen/margin_20"
            android:layout_marginStart="@dimen/size16"
            android:layout_marginTop="@dimen/size12"
            android:src="@drawable/ic_turn_right_arrow"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintEnd_toStartOf="@+id/checkbox"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/checkbox"
            android:layout_width="@dimen/margin_20"
            android:layout_height="@dimen/margin_20"
            android:background="@drawable/ip_list_checkbox1"
            android:button="@null"
            android:checked="false"
            android:layout_marginEnd="@dimen/margin_big"
            app:layout_constraintBottom_toBottomOf="@+id/ivNext"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivNext" />
    </androidx.constraintlayout.widget.ConstraintLayout>

