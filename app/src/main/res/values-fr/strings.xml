  <string name="confirm_accept_msg_1">Bonjour, merci d\'utiliser SuperVPN</string>
  <string name="confirm_accept_msg_2">Nous collectons uniquement les données minimales nécessaires au bon fonctionnement et à la sécurité de votre connexion. Voici un aperçu rapide.</string>
