<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Updated app theme using MaterialComponents -->
    <style name="Theme.SuperVPN" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="textAppearanceHeadline3">@style/App_TextAppearanceTitle1</item>
        <item name="textAppearanceHeadline4">@style/App_TextAppearanceTitle2</item>
        <item name="textAppearanceBody1">@style/App_TextAppearanceBody1</item>
        <item name="textAppearanceBody2">@style/App_TextAppearanceBody2</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Optional: fallback base theme if needed -->
    <style name="Base.Theme.SuperVPN" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Splash theme remains unchanged, just ensure consistency -->
    <style name="Theme.SuperVPN.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#02091A</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <item name="windowSplashScreenAnimationDuration">200</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>

        <item name="android:windowBackground">#02091A</item>
        <item name="android:statusBarColor">#02091A</item>
    </style>

</resources>